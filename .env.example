DIAGRAMFLOW_ENV=development
# Required in production: set a random secret of at least 32 characters.
DIAGRAMFLOW_JWT_SECRET=
# Optional initial administrator password; never use a default password.
DIAGRAMFLOW_ADMIN_PASSWORD=
LLM_PROVIDER=openrouter
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b,anthropic/claude-opus-5.5,stealth/space-bunny-alpha,minimax/minimax-m3.1-flash,stepfun/step-5-preview,openai/gpt-6-luna,qwen/qwen3.8-flash,xiaomi/mimo-v2.6-flash,tencent/hy4-preview,z-ai/glm-5.3-flash,deepseek/deepseek-v4.1-flash-1017,deepseek/deepseek-v4.1-flash
LLM_TIMEOUT_SECONDS=90
DIAGRAMFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DIAGRAMFLOW_HOST=127.0.0.1
PORT=8000
